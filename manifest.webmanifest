{
  "name": "Happy Diwali",
  "short_name": "Diwali",
  "description": "Your name, written across the night sky in fireworks. Send greetings, light crackers, scan a friend's greeting.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#04020c",
  "theme_color": "#04020c",
  "categories": ["entertainment", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Send a greeting", "short_name": "Send", "url": "./?action=send", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a greeting", "short_name": "Scan", "url": "./?action=scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
